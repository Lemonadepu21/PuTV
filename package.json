{
  "name": "putv",
  "version": "2.21.0-putv.1",
  "private": true,
  "description": "基于 LibreTV 的影视聚合搜索与观看平台",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 -p 8080",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 -p 8080",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/create-admin.ts",
    "test:docker": "node scripts/test-docker.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.12",
    "artplayer": "^5.2.3",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.8.2",
    "mux.js": "^6.3.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.25",
    "fake-indexeddb": "6.2.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lemonadepu21/putv.git"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
