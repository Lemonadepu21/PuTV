[Unit]
Description=PuTv local server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Coding/PuTv
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node %h/Coding/PuTv/node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
