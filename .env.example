# 服务端注册邀请码；轮换不会影响已注册账号和会话
PASSWORD=change-me
REGISTRATION_ENABLED=true

# 浏览器访问本站的完整源（协议 + 域名 + 可选端口），生产环境必须 HTTPS
APP_ORIGIN=https://putv.example.com
# 仅可信局域网 / 本机测试可显式开启 HTTP 例外（密码与 Cookie 将无传输加密）
ALLOW_INSECURE_HTTP=false
# 可选：强制 Secure；HTTPS 和未开启 HTTP 例外的生产模式始终开启
COOKIE_SECURE=false

# 源码部署默认 ./data/putv.sqlite；Docker 固定 /app/data/putv.sqlite
SQLITE_PATH=./data/putv.sqlite
SESSION_DAYS=30
MAX_PROFILES=8
# 保留兼容变量，不再参与账号密码或会话生成
# PROXY_SECRET=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/lemonadepu21/putv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# PUTV_IMAGE=ghcr.io/lemonadepu21/putv:<版本>

# Docker 对外端口；源码运行默认同样使用 8080
PUTV_PORT=8080

# 可选：默认源，不在代码中预置第三方视频站
DEFAULT_SOURCES=[]
DEFAULT_LIVE_SOURCES=[]
DEFAULT_SUBSCRIPTIONS=[]
